        </inputEntry>
        <outputEntry id="BU01_A">
          <text>"aufbewahrung"</text>
        </outputEntry>
        <annotationEntry>
          <text>Bücher, Belege und Geschäftsbriefe sind aufzubewahren.</text>
        </annotationEntry>
      </rule>
      <rule id="BU02">
        <inputEntry id="BU02_E1">
          <text>"ug","gmbh"</text>
        </inputEntry>
