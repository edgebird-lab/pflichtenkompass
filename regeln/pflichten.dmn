        </inputEntry>
        <outputEntry id="BU02_A">
          <text>"buchfuehrungHgb"</text>
        </outputEntry>
        <annotationEntry>
          <text>UG und GmbH sind Handelsgesellschaften und führen Bücher.</text>
        </annotationEntry>
      </rule>
      <rule id="BU03">
        <inputEntry id="BU03_E1">
          <text>"gbr"</text>
        </inputEntry>
        <inputEntry id="BU03_E2">
