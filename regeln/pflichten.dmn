<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" id="Pflichten" name="Pflichten-Kompass 2026.11.0" namespace="https://olbricht-digital.de/pflichtenkompass/regeln">
  <description>Regeln des Pflichten-Kompasses, Katalog 2026.11.0, Rechtsstand 11.11.2026. Keine Rechts- oder Steuerberatung. Hit Policy COLLECT; die Eingaben sind die Merkmale aus src/modell/merkmale.ts. Nach jeder Änderung Version und Stand anheben und npm run regeln:stand ausführen.</description>
  <inputData id="Merkmale" name="Merkmale">
    <variable id="Merkmale_Variable" name="Merkmale" />
  </inputData>
  <decision id="Entscheidung_Gruendung" name="Gründung und Anmeldung">
    <informationRequirement id="IR_Gruendung">
      <requiredInput href="#Merkmale" />
    </informationRequirement>
    <decisionTable id="Tabelle_Gruendung" hitPolicy="COLLECT">
      <input id="GR_E1" label="Rechtsform">
        <inputExpression id="GR_E1_A" typeRef="string">
          <text>Merkmale.rechtsform</text>
        </inputExpression>
        <inputValues id="GR_E1_W">
          <text>"einzelunternehmen","gbr","ug","gmbh"</text>
        </inputValues>
      </input>
      <input id="GR_E2" label="Tätigkeit">
        <inputExpression id="GR_E2_A" typeRef="string">
          <text>Merkmale.taetigkeit</text>
        </inputExpression>
        <inputValues id="GR_E2_W">
          <text>"gewerblich","freiberuflich"</text>
        </inputValues>
      </input>
      <input id="GR_E3" label="Kaufmann nach HGB">
        <inputExpression id="GR_E3_A" typeRef="boolean">
          <text>Merkmale.kaufmann</text>
        </inputExpression>
      </input>
      <input id="GR_E4" label="Eingetragene Personengesellschaft">
        <inputExpression id="GR_E4_A" typeRef="boolean">
          <text>Merkmale.personengesellschaftEingetragen</text>
        </inputExpression>
      </input>
      <input id="GR_E5" label="Handwerk">
        <inputExpression id="GR_E5_A" typeRef="string">
          <text>Merkmale.handwerk</text>
        </inputExpression>
        <inputValues id="GR_E5_W">
          <text>"keins","zulassungspflichtig","zulassungsfrei","handwerksaehnlich","unklar"</text>
        </inputValues>
      </input>
      <output id="GR_A" label="Pflicht" name="pflicht" typeRef="string">
        <outputValues id="GR_A_W">
          <text>"gewerbeanzeige","steuerlicheErfassung","handelsregister","handelsregisterGmbh","transparenzregister","handwerksrolle","handwerkAnzeige","berufsgenossenschaft"</text>
        </outputValues>
      </output>
      <annotation name="Begründung" />
      <rule id="GR01">
        <inputEntry id="GR01_E1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR01_E2">
          <text>"gewerblich"</text>
        </inputEntry>
        <inputEntry id="GR01_E3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR01_E4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR01_E5">
          <text>-</text>
        </inputEntry>
        <outputEntry id="GR01_A">
          <text>"gewerbeanzeige"</text>
        </outputEntry>
        <annotationEntry>
          <text>Wer ein stehendes Gewerbe beginnt, zeigt es gleichzeitig an.</text>
        </annotationEntry>
      </rule>
      <rule id="GR02">
        <inputEntry id="GR02_E1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR02_E2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR02_E3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR02_E4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR02_E5">
          <text>-</text>
        </inputEntry>
        <outputEntry id="GR02_A">
          <text>"steuerlicheErfassung"</text>
        </outputEntry>
        <annotationEntry>
          <text>Jede Betriebseröffnung und jede freiberufliche Tätigkeit wird dem Finanzamt mitgeteilt.</text>
        </annotationEntry>
      </rule>
      <rule id="GR03">
        <inputEntry id="GR03_E1">
          <text>"einzelunternehmen","gbr"</text>
        </inputEntry>
        <inputEntry id="GR03_E2">
          <text>"gewerblich"</text>
        </inputEntry>
        <inputEntry id="GR03_E3">
          <text>true</text>
        </inputEntry>
        <inputEntry id="GR03_E4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR03_E5">
          <text>-</text>
        </inputEntry>
        <outputEntry id="GR03_A">
          <text>"handelsregister"</text>
        </outputEntry>
        <annotationEntry>
          <text>Ein Handelsgewerbe macht zum Kaufmann oder zur OHG; beide gehören ins Handelsregister.</text>
        </annotationEntry>
      </rule>
      <rule id="GR04">
        <inputEntry id="GR04_E1">
          <text>"ug","gmbh"</text>
        </inputEntry>
        <inputEntry id="GR04_E2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR04_E3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR04_E4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR04_E5">
          <text>-</text>
        </inputEntry>
        <outputEntry id="GR04_A">
          <text>"handelsregisterGmbh"</text>
        </outputEntry>
        <annotationEntry>
          <text>Die Gesellschaft besteht als solche erst mit der Eintragung.</text>
        </annotationEntry>
      </rule>
      <rule id="GR05">
        <inputEntry id="GR05_E1">
          <text>"ug","gmbh"</text>
        </inputEntry>
        <inputEntry id="GR05_E2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR05_E3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR05_E4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR05_E5">
          <text>-</text>
        </inputEntry>
        <outputEntry id="GR05_A">
          <text>"transparenzregister"</text>
        </outputEntry>
        <annotationEntry>
          <text>UG und GmbH sind juristische Personen des Privatrechts.</text>
        </annotationEntry>
      </rule>
      <rule id="GR06">
        <inputEntry id="GR06_E1">
          <text>"gbr"</text>
        </inputEntry>
        <inputEntry id="GR06_E2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR06_E3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR06_E4">
          <text>true</text>
        </inputEntry>
        <inputEntry id="GR06_E5">
          <text>-</text>
        </inputEntry>
        <outputEntry id="GR06_A">
          <text>"transparenzregister"</text>
        </outputEntry>
        <annotationEntry>
          <text>Eingetragene Personengesellschaften melden ihre wirtschaftlich Berechtigten.</text>
        </annotationEntry>
      </rule>
      <rule id="GR07">
        <inputEntry id="GR07_E1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR07_E2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR07_E3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR07_E4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR07_E5">
          <text>"zulassungspflichtig"</text>
        </inputEntry>
        <outputEntry id="GR07_A">
          <text>"handwerksrolle"</text>
        </outputEntry>
        <annotationEntry>
          <text>Ein zulassungspflichtiges Handwerk darf nur mit Eintragung betrieben werden.</text>
        </annotationEntry>
      </rule>
      <rule id="GR08">
        <inputEntry id="GR08_E1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR08_E2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR08_E3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR08_E4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR08_E5">
          <text>"zulassungsfrei","handwerksaehnlich"</text>
        </inputEntry>
        <outputEntry id="GR08_A">
          <text>"handwerkAnzeige"</text>
        </outputEntry>
        <annotationEntry>
          <text>Der Beginn eines zulassungsfreien oder handwerksähnlichen Gewerbes ist anzuzeigen.</text>
        </annotationEntry>
      </rule>
      <rule id="GR09">
        <inputEntry id="GR09_E1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR09_E2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR09_E3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR09_E4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="GR09_E5">
          <text>-</text>
        </inputEntry>
        <outputEntry id="GR09_A">
          <text>"berufsgenossenschaft"</text>
        </outputEntry>
        <annotationEntry>
          <text>Jedes Unternehmen meldet sich binnen einer Woche beim Unfallversicherungsträger.</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Entscheidung_Personal" name="Personal">
    <informationRequirement id="IR_Personal">
      <requiredInput href="#Merkmale" />
    </informationRequirement>
    <decisionTable id="Tabelle_Personal" hitPolicy="COLLECT">
      <input id="PE_E1" label="Beschäftigte">
        <inputExpression id="PE_E1_A" typeRef="number">
          <text>Merkmale.beschaeftigte</text>
        </inputExpression>
      </input>
      <input id="PE_E2" label="Minijobs">
        <inputExpression id="PE_E2_A" typeRef="number">
          <text>Merkmale.minijobber</text>
        </inputExpression>
      </input>
      <input id="PE_E3" label="Lohnsteuerabzug">
        <inputExpression id="PE_E3_A" typeRef="boolean">
          <text>Merkmale.lohnsteuerabzug</text>
        </inputExpression>
      </input>
      <input id="PE_E4" label="Bereich mit Sofortmeldepflicht">
        <inputExpression id="PE_E4_A" typeRef="boolean">
          <text>Merkmale.sofortmeldeBranche</text>
        </inputExpression>
      </input>
      <output id="PE_A" label="Pflicht" name="pflicht" typeRef="string">
        <outputValues id="PE_A_W">
          <text>"betriebsnummer","svAnmeldung","sofortmeldung","beitragsnachweis","lohnunterlagen","lohnsteuer","arbeitszeitMinijob"</text>
        </outputValues>
      </output>
      <annotation name="Begründung" />
      <rule id="PE01">
        <inputEntry id="PE01_E1">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="PE01_E2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="PE01_E3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="PE01_E4">
          <text>-</text>
        </inputEntry>
        <outputEntry id="PE01_A">
          <text>"betriebsnummer"</text>
        </outputEntry>
        <annotationEntry>
          <text>Wer Beschäftigte meldet, braucht eine Betriebsnummer.</text>
        </annotationEntry>
      </rule>
      <rule id="PE02">
        <inputEntry id="PE02_E1">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="PE02_E2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="PE02_E3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="PE02_E4">
          <text>-</text>
        </inputEntry>
        <outputEntry id="PE02_A">
          <text>"svAnmeldung"</text>
        </outputEntry>
        <annotationEntry>
          <text>Versicherte Beschäftigte werden bei Beginn gemeldet.</text>
        </annotationEntry>
      </rule>
      <rule id="PE03">
        <inputEntry id="PE03_E1">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="PE03_E2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="PE03_E3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="PE03_E4">
          <text>true</text>
        </inputEntry>
        <outputEntry id="PE03_A">
          <text>"sofortmeldung"</text>
        </outputEntry>
        <annotationEntry>
          <text>In bestimmten Bereichen ist der Beginn spätestens bei Arbeitsaufnahme zu melden.</text>
        </annotationEntry>
      </rule>
      <rule id="PE04">
        <inputEntry id="PE04_E1">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="PE04_E2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="PE04_E3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="PE04_E4">
          <text>-</text>
        </inputEntry>
        <outputEntry id="PE04_A">
          <text>"beitragsnachweis"</text>
        </outputEntry>
        <annotationEntry>
          <text>Beiträge werden monatlich nachgewiesen und gezahlt.</text>
        </annotationEntry>
      </rule>
      <rule id="PE05">
        <inputEntry id="PE05_E1">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="PE05_E2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="PE05_E3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="PE05_E4">
          <text>-</text>
        </inputEntry>
        <outputEntry id="PE05_A">
          <text>"lohnunterlagen"</text>
        </outputEntry>
        <annotationEntry>
          <text>Für jede beschäftigte Person sind Lohnkonto und Entgeltunterlagen zu führen.</text>
        </annotationEntry>
      </rule>
      <rule id="PE06">
        <inputEntry id="PE06_E1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="PE06_E2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="PE06_E3">
          <text>true</text>
        </inputEntry>
        <inputEntry id="PE06_E4">
          <text>-</text>
        </inputEntry>
        <outputEntry id="PE06_A">
          <text>"lohnsteuer"</text>
        </outputEntry>
        <annotationEntry>
          <text>Einbehaltene Lohnsteuer wird angemeldet, abgeführt und bescheinigt.</text>
        </annotationEntry>
      </rule>
      <rule id="PE07">
        <inputEntry id="PE07_E1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="PE07_E2">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="PE07_E3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="PE07_E4">
          <text>-</text>
        </inputEntry>
        <outputEntry id="PE07_A">
          <text>"arbeitszeitMinijob"</text>
        </outputEntry>
        <annotationEntry>
          <text>Für Minijobs ist die tägliche Arbeitszeit aufzuzeichnen.</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Entscheidung_Branchen" name="Branchenpflichten">
    <informationRequirement id="IR_Branchen">
      <requiredInput href="#Merkmale" />
    </informationRequirement>
    <decisionTable id="Tabelle_Branchen" hitPolicy="COLLECT">
      <input id="BR_E1" label="Umgang mit Lebensmitteln">
        <inputExpression id="BR_E1_A" typeRef="boolean">
          <text>Merkmale.lebensmittel</text>
        </inputExpression>
      </input>
      <output id="BR_A" label="Pflicht" name="pflicht" typeRef="string">
        <outputValues id="BR_A_W">
          <text>"infektionsschutz"</text>
        </outputValues>
      </output>
      <annotation name="Begründung" />
      <rule id="BR01">
        <inputEntry id="BR01_E1">
          <text>true</text>
        </inputEntry>
        <outputEntry id="BR01_A">
          <text>"infektionsschutz"</text>
        </outputEntry>
        <annotationEntry>
          <text>Wer mit bestimmten Lebensmitteln arbeitet, braucht eine Belehrung nach § 43 IfSG.</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Entscheidung_Steuern" name="Steuern">
    <informationRequirement id="IR_Steuern">
      <requiredInput href="#Merkmale" />
    </informationRequirement>
    <decisionTable id="Tabelle_Steuern" hitPolicy="COLLECT">
      <input id="ST_E1" label="Rechtsform">
        <inputExpression id="ST_E1_A" typeRef="string">
          <text>Merkmale.rechtsform</text>
        </inputExpression>
        <inputValues id="ST_E1_W">
          <text>"einzelunternehmen","gbr","ug","gmbh"</text>
        </inputValues>
      </input>
      <input id="ST_E2" label="Kleinunternehmerregelung">
        <inputExpression id="ST_E2_A" typeRef="boolean">
          <text>Merkmale.kleinunternehmer</text>
        </inputExpression>
      </input>
      <input id="ST_E3" label="Kunden: Unternehmen in Deutschland">
        <inputExpression id="ST_E3_A" typeRef="boolean">
          <text>Merkmale.kundenUnternehmen</text>
        </inputExpression>
      </input>
      <input id="ST_E4" label="Kunden: Unternehmen in anderen EU-Staaten">
        <inputExpression id="ST_E4_A" typeRef="boolean">
          <text>Merkmale.kundenUnternehmenEu</text>
        </inputExpression>
      </input>
      <input id="ST_E5" label="Kunden: Privatleute in anderen EU-Staaten">
        <inputExpression id="ST_E5_A" typeRef="boolean">
          <text>Merkmale.kundenPrivatEu</text>
        </inputExpression>
      </input>
      <input id="ST_E6" label="Kaufmann nach HGB">
        <inputExpression id="ST_E6_A" typeRef="boolean">
          <text>Merkmale.kaufmann</text>
        </inputExpression>
      </input>
      <input id="ST_E7" label="Befreiung nach § 241a HGB">
        <inputExpression id="ST_E7_A" typeRef="boolean">
          <text>Merkmale.hgbBefreit</text>
        </inputExpression>
      </input>
      <input id="ST_E8" label="Handwerk">
        <inputExpression id="ST_E8_A" typeRef="string">
          <text>Merkmale.handwerk</text>
        </inputExpression>
        <inputValues id="ST_E8_W">
          <text>"keins","zulassungspflichtig","zulassungsfrei","handwerksaehnlich","unklar"</text>
        </inputValues>
      </input>
      <input id="ST_E9" label="Kunden: Privatleute in Deutschland">
        <inputExpression id="ST_E9_A" typeRef="boolean">
          <text>Merkmale.kundenPrivat</text>
        </inputExpression>
      </input>
      <output id="ST_A" label="Pflicht" name="pflicht" typeRef="string">
        <outputValues id="ST_A_W">
          <text>"ustVoranmeldung","ustJahreserklaerung","kleinunternehmerGrenzen","rechnungen","eRechnungEmpfang","eRechnungAusstellen","zusammenfassendeMeldung","euFernverkauf","einkommensteuererklaerung","feststellungserklaerung","eBilanz","estVorauszahlungen"</text>
        </outputValues>
      </output>
      <annotation name="Begründung" />
      <rule id="ST01">
        <inputEntry id="ST01_E1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST01_E2">
          <text>false</text>
        </inputEntry>
        <inputEntry id="ST01_E3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST01_E4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST01_E5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST01_E6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST01_E7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST01_E8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST01_E9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="ST01_A">
          <text>"ustVoranmeldung"</text>
        </outputEntry>
        <annotationEntry>
          <text>Ohne Kleinunternehmerregelung sind Voranmeldungen abzugeben.</text>
        </annotationEntry>
      </rule>
      <rule id="ST02">
        <inputEntry id="ST02_E1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST02_E2">
          <text>false</text>
        </inputEntry>
        <inputEntry id="ST02_E3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST02_E4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST02_E5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST02_E6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST02_E7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST02_E8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST02_E9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="ST02_A">
          <text>"ustJahreserklaerung"</text>
        </outputEntry>
        <annotationEntry>
          <text>Ohne Kleinunternehmerregelung ist eine Jahreserklärung abzugeben.</text>
        </annotationEntry>
      </rule>
      <rule id="ST03">
        <inputEntry id="ST03_E1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST03_E2">
          <text>true</text>
        </inputEntry>
        <inputEntry id="ST03_E3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST03_E4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST03_E5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST03_E6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST03_E7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST03_E8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST03_E9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="ST03_A">
          <text>"kleinunternehmerGrenzen"</text>
        </outputEntry>
        <annotationEntry>
          <text>Die Steuerbefreiung gilt nur innerhalb der Umsatzgrenzen.</text>
        </annotationEntry>
      </rule>
      <rule id="ST04">
        <inputEntry id="ST04_E1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST04_E2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST04_E3">
          <text>true</text>
        </inputEntry>
        <inputEntry id="ST04_E4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST04_E5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST04_E6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST04_E7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST04_E8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ST04_E9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="ST04_A">
          <text>"rechnungen"</text>
        </outputEntry>
        <annotationEntry>
