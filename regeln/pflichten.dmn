  <decision id="Entscheidung_Buchfuehrung" name="Buchführung, Abschluss und Kasse">
    <informationRequirement id="IR_Buchfuehrung">
      <requiredInput href="#Merkmale" />
    </informationRequirement>
    <decisionTable id="Tabelle_Buchfuehrung" hitPolicy="COLLECT">
      <input id="BU_E1" label="Rechtsform">
        <inputExpression id="BU_E1_A" typeRef="string">
          <text>Merkmale.rechtsform</text>
        </inputExpression>
        <inputValues id="BU_E1_W">
          <text>"einzelunternehmen","gbr","ug","gmbh"</text>
        </inputValues>
      </input>
      <input id="BU_E2" label="Kaufmann nach HGB">
        <inputExpression id="BU_E2_A" typeRef="boolean">
          <text>Merkmale.kaufmann</text>
        </inputExpression>
      </input>
      <input id="BU_E3" label="Befreiung nach § 241a HGB">
        <inputExpression id="BU_E3_A" typeRef="boolean">
          <text>Merkmale.hgbBefreit</text>
        </inputExpression>
      </input>
      <input id="BU_E4" label="Grenze nach § 141 AO überschritten">
        <inputExpression id="BU_E4_A" typeRef="boolean">
          <text>Merkmale.ao141Grenze</text>
        </inputExpression>
      </input>
      <input id="BU_E5" label="Bargeld">
        <inputExpression id="BU_E5_A" typeRef="boolean">
          <text>Merkmale.bargeld</text>
        </inputExpression>
      </input>
      <input id="BU_E6" label="Kasse">
        <inputExpression id="BU_E6_A" typeRef="string">
          <text>Merkmale.kasse</text>
        </inputExpression>
        <inputValues id="BU_E6_W">
          <text>"keine","offeneLadenkasse","elektronisch"</text>
        </inputValues>
      </input>
      <output id="BU_A" label="Pflicht" name="pflicht" typeRef="string">
        <outputValues id="BU_A_W">
          <text>"aufbewahrung","buchfuehrungHgb","buchfuehrungAo141","kassenfuehrung","elektronischeKasse","jahresabschluss","offenlegung","ugRuecklage","geschaeftsbriefe"</text>
        </outputValues>
      </output>
      <annotation name="Begründung" />
      <rule id="BU01">
        <inputEntry id="BU01_E1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="BU01_E2">
