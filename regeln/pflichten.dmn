  <decision id="Entscheidung_Online" name="Online und Verpackung">
    <informationRequirement id="IR_Online">
      <requiredInput href="#Merkmale" />
    </informationRequirement>
    <decisionTable id="Tabelle_Online" hitPolicy="COLLECT">
      <input id="ON_E1" label="Online-Auftritt">
        <inputExpression id="ON_E1_A" typeRef="boolean">
          <text>Merkmale.website</text>
        </inputExpression>
      </input>
      <input id="ON_E2" label="Waren in Verpackungen an Privatleute">
        <inputExpression id="ON_E2_A" typeRef="boolean">
          <text>Merkmale.verpackungen</text>
        </inputExpression>
      </input>
      <output id="ON_A" label="Pflicht" name="pflicht" typeRef="string">
        <outputValues id="ON_A_W">
          <text>"impressum","verpackung","verpackungDatenmeldung"</text>
        </outputValues>
      </output>
      <annotation name="Begründung" />
      <rule id="ON01">
        <inputEntry id="ON01_E1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="ON01_E2">
          <text>-</text>
        </inputEntry>
        <outputEntry id="ON01_A">
          <text>"impressum"</text>
        </outputEntry>
        <annotationEntry>
          <text>Geschäftsmäßige digitale Dienste brauchen Anbieterangaben.</text>
        </annotationEntry>
      </rule>
      <rule id="ON02">
        <inputEntry id="ON02_E1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ON02_E2">
          <text>true</text>
        </inputEntry>
        <outputEntry id="ON02_A">
          <text>"verpackung"</text>
        </outputEntry>
        <annotationEntry>
          <text>Hersteller systembeteiligungspflichtiger Verpackungen registrieren sich und beteiligen sich an einem System.</text>
        </annotationEntry>
      </rule>
      <rule id="ON03">
        <inputEntry id="ON03_E1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ON03_E2">
          <text>true</text>
        </inputEntry>
        <outputEntry id="ON03_A">
          <text>"verpackungDatenmeldung"</text>
        </outputEntry>
        <annotationEntry>
          <text>Die Mengen der beteiligten Verpackungen gehen auch an die Zentrale Stelle.</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Entscheidung_Luecken" name="Nicht geprüfte Bereiche">
    <informationRequirement id="IR_Luecken">
      <requiredInput href="#Merkmale" />
    </informationRequirement>
    <decisionTable id="Tabelle_Luecken" hitPolicy="COLLECT">
      <input id="LU_E1" label="Rechtsform">
        <inputExpression id="LU_E1_A" typeRef="string">
          <text>Merkmale.rechtsform</text>
        </inputExpression>
        <inputValues id="LU_E1_W">
          <text>"einzelunternehmen","gbr","ug","gmbh"</text>
        </inputValues>
      </input>
      <input id="LU_E2" label="Tätigkeit">
        <inputExpression id="LU_E2_A" typeRef="string">
          <text>Merkmale.taetigkeit</text>
        </inputExpression>
        <inputValues id="LU_E2_W">
          <text>"gewerblich","freiberuflich"</text>
        </inputValues>
      </input>
      <input id="LU_E3" label="Kaufmännischer Betrieb">
        <inputExpression id="LU_E3_A" typeRef="string">
          <text>Merkmale.kaufmaennisch</text>
        </inputExpression>
        <inputValues id="LU_E3_W">
          <text>"ja","nein","unklar"</text>
        </inputValues>
      </input>
      <input id="LU_E4" label="Handwerk">
        <inputExpression id="LU_E4_A" typeRef="string">
          <text>Merkmale.handwerk</text>
        </inputExpression>
        <inputValues id="LU_E4_W">
          <text>"keins","zulassungspflichtig","zulassungsfrei","handwerksaehnlich","unklar"</text>
        </inputValues>
      </input>
      <input id="LU_E5" label="Handel">
