          <text>-</text>
        </inputEntry>
        <inputEntry id="BU03_E5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="BU03_E6">
          <text>-</text>
        </inputEntry>
        <outputEntry id="BU03_A">
          <text>"buchfuehrungHgb"</text>
        </outputEntry>
        <annotationEntry>
          <text>Eine OHG ist Handelsgesellschaft; die Befreiung nach § 241a HGB gilt nur für Einzelkaufleute.</text>
        </annotationEntry>
      </rule>
      <rule id="BU04">
